# --- sırlar (K8) ---
# DESEN GENİŞ TUTULUR. `config/local.yaml` ve `config/local.*.yaml` yeterli
# değildi: 18.08.2026'da alınan bir yedek `config/local.yaml.yedek-<damga>`
# adıyla İKİSİNE DE UYMADI ve commit'e girdi. GitHub'ın sır koruması push'u
# kesti (Google servis hesabı anahtarı) — yani deponun kendi kapısı değil,
# dışarıdaki bir kapı yakaladı. Artık `local` ile başlayan her şey elenir.
config/local*
!config/local.example.yaml
# Elle bırakılan belirteç/sır notları. Değer config/local.yaml kasasına
# taşınır; bu dosyalar depoya ASLA girmez.
*token*.md
*token*.txt
*secret*.md
*secret*.txt
*.pem
*.key
.env
.env.*

# --- çalışma anı verisi ---
data/*
!data/README.md
!data/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- node / tauri ---
node_modules/
apps/desktop/src-tauri/target/
apps/desktop/**/dist/

# --- editör / sistem ---
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# --- üretilen dosyalar ---
apps/desktop/shell/registry.json
apps/desktop/shell/panels/
# Panel kopyası ATOMİK takas ile yerine geçiyor; bunlar takas anındaki
# geçici klasörler ve normalde saniyeden kısa yaşarlar (derleme yarıda
# kesilirse kalabilirler).
apps/desktop/shell/.panels-yeni/
apps/desktop/shell/.panels-eski/

# İş akışı betiği — geçici, depoya girmez.
.km-tur.js
backend/src/km_core/_build_stamp.py
