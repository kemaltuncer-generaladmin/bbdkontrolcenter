{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bbd_canteen_backups ayarları",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "local_path": {
      "type": "string",
      "description": "İndirilen yedeklerin klasörü. Boşsa data/backups kullanılır."
    },
    "keep_local": {
      "type": "integer", "minimum": 1, "maximum": 200,
      "description": "Yerelde tutulacak en çok kopya."
    },
    "stale_after_minutes": {
      "type": "integer", "minimum": 1, "maximum": 10080,
      "description": "Son yedek bu süreden eskiyse uyarı verilir."
    }
  }
}
