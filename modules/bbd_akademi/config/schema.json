{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {"type": "boolean"},
    "base_url": {"type": "string", "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$"},
    "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 120},
    "upload_timeout_seconds": {"type": "number", "minimum": 5, "maximum": 600},
    "max_upload_mb": {"type": "integer", "minimum": 1, "maximum": 100},
    "download_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "staff_sync_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
    "step_up_seconds": {"type": "integer", "minimum": 30, "maximum": 600},
    "read_retry_seconds": {"type": "number", "minimum": 0, "maximum": 60},
    "document_title": {"type": "string", "maxLength": 120},
    "club_store_watch_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
  }
}
