{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "institution_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "timezone": {"type": "string", "minLength": 1},
    "otp_template": {"type": "string", "minLength": 8, "maxLength": 300, "pattern": "\\{code\\}"},
    "call_templates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth_max_failures": {"type": "integer", "minimum": 1, "maximum": 50},
        "auth_window_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "lookup_per_minute": {"type": "integer", "minimum": 1, "maximum": 30},
        "sms_per_phone_per_hour": {"type": "integer", "minimum": 1, "maximum": 50},
        "sms_global_per_minute": {"type": "integer", "minimum": 1, "maximum": 600},
        "call_cooldown_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "idempotency_hours": {"type": "integer", "minimum": 24, "maximum": 168},
    "products_cache_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
    "bell_week_cache_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
    "groups_cache_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
    "canteen_settings_cache_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "write_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}
      }
    },
    "sms_log_retention_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "audit_retention_days": {"type": "integer", "minimum": 30, "maximum": 3650}
  }
}
