{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timezone": {"type": "string", "minLength": 1},
    "enrollment_code_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
    "sync_active_seconds": {"type": "integer", "minimum": 15, "maximum": 3600},
    "sync_idle_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "usage_flush_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "session_idle_minutes": {"type": "integer", "minimum": 5, "maximum": 240},
    "history_retention_days": {"type": "integer", "minimum": 7, "maximum": 3650},
    "download_slots": {"type": "integer", "minimum": 1, "maximum": 20},
    "download_lease_seconds": {"type": "integer", "minimum": 300, "maximum": 3600},
    "queue_stale_seconds": {"type": "integer", "minimum": 300, "maximum": 7200},
    "max_upload_mb": {"type": "integer", "minimum": 1, "maximum": 65536},
    "storage_dir": {"type": "string"},
    "public_base_url": {"type": "string", "pattern": "^(https?://[^/?#]+/?)?$"}
  }
}
